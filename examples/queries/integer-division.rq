# Averaging and dividing integers.
# Spec: integer / integer is xsd:decimal, and so is AVG over integers:
# ?avg = ?ratio = 23.5 (xsd:decimal). ?third = 0.333... (xsd:decimal).
PREFIX ex: <http://example.org/>
SELECT (AVG(?age) AS ?avg) (SUM(?age) / COUNT(?age) AS ?ratio) (1 / 3 AS ?third)
WHERE { ?person ex:age ?age }
